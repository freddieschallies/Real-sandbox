# Copy to .env on the office server and fill in. Never commit the real .env.
MIGRATION_DATABASE_URL=postgres://realsandbox:CHANGE_ME@localhost:5432/realsandbox
DATABASE_URL=postgres://rs_app:CHANGE_ME_TOO@localhost:5432/realsandbox
JWT_SECRET=CHANGE_ME_to_a_random_string_of_at_least_32_characters
PORT=8080
CORS_ORIGINS=
# Reads photographed supplier invoices automatically (Claude API key from console.anthropic.com).
# Leave empty and technicians type invoice lines themselves.
ANTHROPIC_API_KEY=
INVOICE_MODEL=claude-sonnet-5-5
