# Copy to deploy/.env on the office server and fill in. Never commit the real .env.
# Make long random values with:  openssl rand -hex 24
# (hex only: the database passwords go inside an address, where symbols like + / = break it)
DB_PASSWORD=CHANGE_ME
# The app's own restricted database user (different from DB_PASSWORD).
APP_DB_PASSWORD=CHANGE_ME_TOO
JWT_SECRET=CHANGE_ME_at_least_32_random_characters
# Where the daily backups are written on the server: best a second disk, e.g. /mnt/backup-disk/realsandbox.
BACKUP_DIR=./backups
# When the daily backup runs (office time). If the server is off then, it runs when it is back on.
BACKUP_TIME=01:30
# The cloud copy (encrypted on this server before it goes). Cloudflare R2 is recommended: R2 > Create bucket,
# then R2 > Manage API tokens > Create (Object Read & Write for that bucket). Empty CLOUD_BUCKET: no cloud copy.
CLOUD_PROVIDER=Cloudflare
CLOUD_BUCKET=
CLOUD_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
CLOUD_ACCESS_KEY_ID=
CLOUD_SECRET_ACCESS_KEY=
# 1: photos go to the cloud too (they are compressed); 0: only the database and documents.
CLOUD_PHOTOS=1
# Encrypts the cloud copy. Write it down and keep it away from this server: without it the cloud copy cannot be read.
BACKUP_PASSPHRASE=CHANGE_ME_a_long_sentence_you_keep_on_paper
# Online server (VPS) only: the web address people open (it must point at this server's IP address).
# PUBLIC_URL below is then https://<DOMAIN>.
DOMAIN=
# Office PC only: from Cloudflare Zero Trust > Tunnels, when the tunnel is set up.
TUNNEL_TOKEN=
# Web addresses allowed to call the API from a browser (the control base), comma separated.
CORS_ORIGINS=
# Reading supplier invoices and breakdown emails with AI (optional; without it simple rules are used).
ANTHROPIC_API_KEY=
# The WhatsApp link (companies' own phones, linked by scanning a QR code in the app): a long random key.
WA_BRIDGE_KEY=CHANGE_ME_openssl_rand_hex_24
# The official WhatsApp number option (optional): from Real Sandbox's own Meta app, once (see OFFICE-SERVER.md).
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
WA_VERIFY_TOKEN=
# Finding store addresses on the map. Empty: OpenStreetMap (free; put a contact email in NOMINATIM_EMAIL).
# A Google Maps key (Geocoding API) finds shop addresses better; Google charges per lookup after its free allowance.
GOOGLE_MAPS_KEY=
NOMINATIM_EMAIL=

# Sending email (site reports, statements, documents for a job). Gmail: an app password, never your own password.
# MAIL_URL=smtps://you%40gmail.com:APP-PASSWORD@smtp.gmail.com:465
MAIL_URL=
MAIL_FROM=
# The address the tunnel gives the server (e.g. https://app.zsp.co.za): used in document links sent on WhatsApp.
PUBLIC_URL=
