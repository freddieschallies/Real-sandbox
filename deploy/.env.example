# Copy to deploy/.env on the office server and fill in. Never commit the real .env.
# Make long random values, e.g.:  openssl rand -base64 36
DB_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_at_least_32_random_characters
# Where nightly backups are written on the server (copy this folder off-site).
BACKUP_DIR=./backups
# From Cloudflare Zero Trust > Tunnels, when the tunnel is set up.
TUNNEL_TOKEN=
# Web addresses allowed to call the API from a browser (the control base), comma separated.
CORS_ORIGINS=
