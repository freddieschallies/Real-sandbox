# One web address for everything: the app's pages, and the API behind them.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# The app's own files (the page, its scripts, pictures, the QR reader).
	@app file {
		root /srv/web
		try_files {path} {path}/index.html
	}
	handle @app {
		root * /srv/web
		@long path /_expo/* /assets/*
		header @long Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# Everything else is the API (sign-in, jobs, photos, WhatsApp webhooks, document links).
	handle {
		reverse_proxy api:8080 {
			header_up X-Forwarded-Proto https
		}
	}
	request_body {
		max_size 50MB
	}
}
