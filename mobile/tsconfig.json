{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "moduleSuffixes": [
      ".web",
      ""
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../server/src/core/*.ts"
  ],
  "exclude": [
    "test",
    "node_modules"
  ]
}
